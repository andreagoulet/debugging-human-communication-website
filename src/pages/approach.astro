---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CALENDLY_URL } from '../utils/constants';
import { formatMarkdown } from '../utils/formatMarkdown';

const allContent = await getCollection('website');
const content = Object.fromEntries(
  allContent.map(entry => [entry.id, entry])
);

const premise = content['approach/premise.md'].data;
const premiseParagraphs = (premise.paragraphs ?? []).map((p) =>
  typeof p === 'string' ? { text: p, emphasis: undefined } : p
);
const example = content['approach/example.md'].data.example;
const together = content['approach/together.md'].data;
const footer = content['shared/footer.md'].data;
---

<Layout title="Approach | Debugging Human Communication" description="Andrea Goulet's experiment-driven approach to communication coaching — treat communication as a debuggable system and improve it one small experiment at a time.">
  <SiteHeader currentPath="/approach" />

  <main>
    <!-- Page Hero -->
    <section class="bg-teal-950 px-6">
      <div class="container-lg">
        <div class="py-10 md:py-14 max-w-2xl">
          <h1 class="heading-hero !text-white">Approach</h1>
        </div>
      </div>
    </section>

    <!-- Premise -->
    <section class="section bg-teal-50">
      <div class="container-sm">
        <h2 class="heading-section mb-8 text-center" set:html={formatMarkdown(premise.title || '')} />
        {premiseParagraphs.map((p) => (
          <p class:list={["text-lg text-teal-900 mb-6", p.emphasis === 'bold' && 'font-bold text-teal-950 text-center', p.emphasis === 'italic' && 'italic']} set:html={formatMarkdown(p.text)} />
        ))}

        <div class="bg-white rounded-2xl p-6 md:p-10 border border-teal-200 shadow-sm mt-10">
          <img
            src="/images/impact-influence-loop.webp"
            alt="The Impact & Influence loop: Identify — describe your communication challenge precisely. Interact — run a communication experiment. Improve — gather data and integrate learnings."
            class="w-full h-auto"
            width="1600"
            height="1075"
            loading="lazy"
          />
        </div>

        {premise.testimonial && (
          <blockquote class="border-l-4 border-purple bg-white rounded-r-lg pl-6 pr-4 py-6 italic text-teal-900 mt-10">
            "{premise.testimonial.quote}"
            <footer class="mt-2 not-italic">
              <span class="text-teal-950 font-medium">— {premise.testimonial.author}</span>
              {premise.testimonial.role && <span class="text-teal-900 text-sm block mt-1">{premise.testimonial.role}</span>}
            </footer>
          </blockquote>
        )}
      </div>
    </section>

    <!-- Concrete example: general advice vs. the experiment -->
    {example && (
      <section class="section bg-white">
        <div class="container-lg">
          <div class="container-sm mx-auto text-center mb-12">
            <h2 class="heading-section mb-6">{example.title}</h2>
            <p class="text-lg text-teal-900" set:html={formatMarkdown(example.setup)} />
          </div>

          <div class="grid md:grid-cols-2 gap-8 items-stretch mb-10">
            <div class="bg-teal-50 rounded-xl p-8 border border-teal-200">
              <h3 class="text-lg font-bold text-teal-800 mb-4">{example.advice.title}</h3>
              <ul class="space-y-2">
                {example.advice.bullets.map((bullet) => (
                  <li class="flex items-start gap-2 text-teal-900">
                    <span class="text-coral mt-0.5 shrink-0 font-bold">&#10007;</span>
                    <span set:html={formatMarkdown(bullet)} />
                  </li>
                ))}
              </ul>
              {example.advice.results && (
                <>
                  <h4 class="text-base font-bold text-teal-800 mt-6 mb-3">{example.advice.results.title}</h4>
                  <ul class="space-y-2">
                    {example.advice.results.bullets.map((bullet) => (
                      <li class="flex items-start gap-2 text-teal-900">
                        <span class="text-teal-400 mt-0.5 shrink-0">&#8594;</span>
                        <span set:html={formatMarkdown(bullet)} />
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>

            <div class="bg-white rounded-xl p-8 border-2 border-teal-600 shadow-sm">
              <h3 class="text-lg font-bold text-teal-950 mb-4">{example.experiment.title}</h3>
              <ul class="space-y-3">
                {example.experiment.bullets.map((bullet) => (
                  <li class="flex items-start gap-2 text-teal-900">
                    <span class="text-teal-600 mt-0.5 shrink-0 font-bold">&#10003;</span>
                    <span>
                      {bullet.label && <span class="font-bold text-teal-950">{bullet.label} — </span>}
                      <span set:html={formatMarkdown(bullet.text)} />
                    </span>
                  </li>
                ))}
              </ul>
              {example.experiment.results && (
                <>
                  <h4 class="text-base font-bold text-teal-950 mt-6 mb-3">{example.experiment.results.title}</h4>
                  <ul class="space-y-2">
                    {example.experiment.results.bullets.map((bullet) => (
                      <li class="flex items-start gap-2 text-teal-900">
                        <span class="text-teal-600 mt-0.5 shrink-0">&#8594;</span>
                        <span set:html={formatMarkdown(bullet)} />
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </div>

          {example.testimonial && (
            <div class="container-sm mx-auto mt-10">
              <blockquote class="border-l-4 border-purple bg-teal-50 rounded-r-lg pl-6 pr-4 py-6 italic text-teal-900">
                "{example.testimonial.quote}"
                <footer class="mt-2 not-italic">
                  <span class="text-teal-950 font-medium">— {example.testimonial.author}</span>
                  {example.testimonial.role && <span class="text-teal-900 text-sm block mt-1">{example.testimonial.role}</span>}
                </footer>
              </blockquote>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Working together -->
    <section class="section bg-teal-50">
      <div class="container-md">
        <h2 class="heading-section mb-10 text-center" set:html={formatMarkdown(together.title || '')} />

        {together.items && (
          <div class="grid md:grid-cols-3 gap-6">
            {together.items.map((item) => (
              <div class="bg-white rounded-xl p-6 border border-teal-200">
                <h3 class="text-lg font-bold text-teal-950 mb-2">{item.title}</h3>
                <p class="text-teal-900" set:html={formatMarkdown(item.description)} />
              </div>
            ))}
          </div>
        )}

        {together.testimonial && (
          <blockquote class="border-l-4 border-purple bg-white rounded-r-lg pl-6 pr-4 py-6 italic text-teal-900 mt-10">
            "{together.testimonial.quote}"
            <footer class="mt-2 not-italic">
              <span class="text-teal-950 font-medium">— {together.testimonial.author}</span>
              {together.testimonial.role && <span class="text-teal-900 text-sm block mt-1">{together.testimonial.role}</span>}
            </footer>
          </blockquote>
        )}
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="section bg-teal-950">
      <div class="container-sm text-center">
        <h2 class="heading-section !text-white mb-8" set:html={formatMarkdown(together.closingText || '')} />
        <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Book Your Coaching Experience →
        </a>
      </div>
    </section>

    <SiteFooter
      contactEmail={footer.contactEmail || ''}
      copyright={footer.copyright || ''}
      termsUrl={footer.termsUrl || ''}
      privacyUrl={footer.privacyUrl || ''}
    />
  </main>
</Layout>
