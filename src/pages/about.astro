---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageCta from '../components/PageCta.astro';
import FAQItem from '../components/FAQItem.astro';
import { formatMarkdown } from '../utils/formatMarkdown';

const allContent = await getCollection('website');
const content = Object.fromEntries(
  allContent.map(entry => [entry.id, entry])
);

const meetAndrea = content['about/bio.md'].data;
const faq = content['about/faq.md'].data;
const footer = content['shared/footer.md'].data;
---

<Layout title="About Andrea Goulet | Debugging Human Communication" description="Meet Andrea Goulet — 25 years studying the mechanics of human communication, helping technical professionals communicate more effectively.">
  <SiteHeader currentPath="/about" />

  <main>
    <!-- Page Hero -->
    <section class="bg-teal-950 px-6">
      <div class="container-lg">
        <div class="py-10 md:py-14 max-w-2xl">
          <h1 class="heading-hero !text-white">About Andrea Goulet</h1>
        </div>
      </div>
    </section>

    <!-- Full Bio -->
    <section class="section bg-white">
      <div class="container-md">
        <div>
          <img src="/images/andrea-with-computer.webp" alt="Andrea Goulet" class="w-80 rounded-2xl shadow-sm float-right ml-8 mb-6 hidden md:block" />
          <img src="/images/andrea-with-computer.webp" alt="Andrea Goulet" class="w-64 rounded-2xl shadow-sm mx-auto mb-8 md:hidden" />

          {meetAndrea.paragraphs?.map((p) => (
            <p class="text-lg text-teal-900 mb-6" set:html={formatMarkdown(typeof p === 'string' ? p : p.text)} />
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section bg-teal-50">
      <div class="container-md">
        <h2 class="heading-section mb-12 text-center" set:html={formatMarkdown(faq.title || '')} />

        <div class="space-y-8">
          {faq.questions?.map((item) => (
            <FAQItem question={item.question} answer={item.answer} />
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <PageCta />

    <SiteFooter
      contactEmail={footer.contactEmail || ''}
      copyright={footer.copyright || ''}
      termsUrl={footer.termsUrl || ''}
      privacyUrl={footer.privacyUrl || ''}
    />
  </main>
</Layout>
