---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { formatMarkdown } from '../../utils/formatMarkdown';

const footer = (await getCollection('website')).find(e => e.id === 'shared/footer.md')!.data;

const allLandingPages = await getCollection('landing-pages');
const content = allLandingPages.find(e => e.id === 'referred-landing.md')!.data;
---

<Layout
  title="Claim Your Free Guest Pass | Communication Debugging Workshop"
  description="Get a free guest pass to attend our next live Communication Debugging Workshop. Schedule a quick fit call to get started."
  noindex={true}
>
  <main>
    <!-- Hero -->
    <section class="relative bg-teal-950 overflow-hidden px-6">
      <div class="absolute inset-0" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-br from-teal-950 via-teal-950/95 to-teal-800/30"></div>
      </div>
      <div class="container-lg relative z-10 py-16 md:py-24 text-center">
        <img src="/logo.svg" alt="Debugging Human Communication" class="h-16 w-auto mx-auto mb-8" />
        <!-- Event badge -->
        <div class="inline-flex flex-col items-center gap-2 mb-8">
          <span class="inline-block bg-teal-600 text-teal-950 text-base md:text-lg font-bold uppercase tracking-wider px-6 py-3 rounded-full">{content.hero.badge}</span>
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-teal-300 text-lg md:text-xl">
            <span>{content.hero.badgeDetails}</span>
          </div>
        </div>

        <h1 class="heading-hero !text-white mb-4" set:html={formatMarkdown(content.hero.headline)} />

        <p class="text-lg md:text-xl text-teal-200 max-w-3xl mx-auto mb-10" set:html={formatMarkdown(content.hero.subheadline)} />

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <!-- Intro Video -->
          <div>
            <div class="rounded-xl overflow-hidden border-2 border-teal-600/40 bg-teal-900/60">
              <video
                class="w-full aspect-video"
                controls
                preload="metadata"
                poster="/videos/dhc-workshop-intro-poster.png"
              >
                <source src="/videos/dhc-workshop-intro.mp4" type="video/mp4" />
                <track src="/videos/dhc-workshop-intro-subtitles.vtt" kind="subtitles" srclang="en" label="English" default />
                Your browser does not support the video tag.
              </video>
            </div>
            <p class="mt-3 text-center text-teal-400 text-sm">Having trouble seeing the calendar? <a href="https://links.debugginghumancommunication.com/widget/booking/AtiyMWERWdg3TT1IQwVh" target="_blank" rel="noopener noreferrer" class="underline hover:text-teal-300">Book directly here</a>.</p>
          </div>

          <!-- Booking Widget -->
          <div class="rounded-xl overflow-hidden bg-white">
            <iframe src="https://links.debugginghumancommunication.com/widget/booking/AtiyMWERWdg3TT1IQwVh" class="w-full border-none" style="min-height:420px;" scrolling="no" title="Book a workshop prep call"></iframe>
            <script type="text/javascript" src="https://links.debugginghumancommunication.com/js/form_embed.js"></script>
          </div>
        </div>
      </div>
    </section>

    <!-- What Will You Learn? -->
    <section class="section bg-white">
      <div class="container-md">
        <h2 class="heading-section mb-8 text-center">{content.whatYoullLearn.title}</h2>
        <p class="text-lg text-teal-900 mb-8 text-center">{content.whatYoullLearn.intro}</p>

        <div class="space-y-6 mb-8">
          {content.whatYoullLearn.items.map((item: string) => (
            <div class="flex gap-4 items-start">
              <div class="w-2 h-2 rounded-full bg-teal-800 mt-3 shrink-0"></div>
              <p class="text-lg text-teal-900" set:html={formatMarkdown(item)} />
            </div>
          ))}
        </div>

        <p class="text-lg text-teal-900 italic text-center font-medium">
          {content.whatYoullLearn.closing}
        </p>
      </div>
    </section>

    <!-- What the Upgrade Looks Like -->
    <section class="section bg-teal-950">
      <div class="container-md">
        <h2 class="heading-section !text-white mb-4 text-center">{content.imagine.title}</h2>
        <p class="text-teal-300 text-lg text-center mb-10">{content.imagine.subtitle}</p>

        <div class="max-w-3xl mx-auto mb-10 bg-white rounded-2xl overflow-hidden shadow-xl">
          {content.imagine.items.map((item: { before: string; after: string }, index: number) => (
            <div class:list={["grid grid-cols-[1fr_auto_1fr] items-center gap-x-4 px-6 py-5", index < content.imagine.items.length - 1 && "border-b border-teal-200"]}>
              <p class="text-teal-900 text-lg">{item.before}</p>
              <svg class="w-6 h-6 text-coral shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" role="img" aria-label="becomes"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              <p class="text-teal-950 font-bold text-lg">{item.after}</p>
            </div>
          ))}
        </div>

        <p class="text-teal-300 text-lg font-medium max-w-2xl mx-auto text-center">{content.imagine.closing}</p>
      </div>
    </section>

    <!-- What Makes This Event Different? -->
    <section class="section bg-white">
      <div class="container-md">
        <h2 class="heading-section mb-10 text-center">{content.differentiators.title}</h2>

        <div class="grid md:grid-cols-2 gap-6 mb-10">
          {content.differentiators.items.map((item: { title: string; description: string }) => (
            <div class="bg-teal-50 rounded-xl p-6 border border-teal-200">
              <h3 class="text-lg font-bold text-teal-950 mb-2">{item.title}</h3>
              <p class="text-teal-900">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Your Host -->
    <section class="section bg-teal-50">
      <div class="container-md">
        <h2 class="heading-section mb-10 text-center">{content.host.title}</h2>

        <div class="flex flex-col md:flex-row md:items-start gap-8">
          <div class="w-64 shrink-0 mx-auto md:mx-0 overflow-hidden shadow-sm" style="aspect-ratio: 3/4; border-radius: 1rem; border: 0.5rem solid white;">
            <img src="/images/andrea-with-computer.webp" alt="Andrea Goulet" class="w-full h-full object-cover object-top" />
          </div>
          <div>
            <p class="text-lg text-teal-900 leading-relaxed">
              {content.host.bio}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section bg-teal-100">
      <div class="container-sm">
        <h2 class="heading-section mb-10 text-center">{content.faq.title}</h2>

        <div class="space-y-3">
          {content.faq.questions.map((item: { question: string; answer: string }) => (
            <details class="bg-white rounded-lg border border-teal-200 group overflow-hidden">
              <summary class="cursor-pointer p-5 font-bold text-teal-950 text-lg flex items-center justify-between gap-4 list-none">
                <span>{item.question}</span>
                <svg class="w-5 h-5 text-teal-700 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="px-5 pb-5 pt-1 text-lg text-teal-900">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- The Next Step -->
    <section class="section bg-white">
      <div class="container-sm">
        <h2 class="heading-section mb-8 text-center">{content.nextStep.title}</h2>

        <div class="prose-custom">
          {content.nextStep.paragraphs.map((p: string) => (
            <p set:html={formatMarkdown(p)} />
          ))}
        </div>

        <ul class="space-y-6 mt-6 max-w-2xl mx-auto">
          {content.nextStep.bullets.map((b: string) => (
            <li class="flex gap-4 items-start">
              <div class="w-2 h-2 rounded-full bg-teal-800 mt-3 shrink-0"></div>
              <p class="text-lg text-teal-900" set:html={formatMarkdown(b)} />
            </li>
          ))}
        </ul>

        {content.nextStep.callout && (
          <p class="bg-teal-50 rounded-lg p-4 border border-teal-200 text-teal-950 font-medium mt-8 max-w-2xl mx-auto" set:html={formatMarkdown(content.nextStep.callout)} />
        )}

        {content.nextStep.closingParagraphs && (
          <div class="prose-custom mt-8">
            {content.nextStep.closingParagraphs.map((p: string) => (
              <p set:html={formatMarkdown(p)} />
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Bottom Booking Widget -->
    <section class="section bg-teal-50">
      <div class="container-sm">
        <iframe src="https://links.debugginghumancommunication.com/widget/booking/AtiyMWERWdg3TT1IQwVh" class="w-full border-none" style="min-height:700px;" scrolling="no" title="Book a workshop prep call"></iframe>
        <script type="text/javascript" src="https://links.debugginghumancommunication.com/js/form_embed.js"></script>
        <p class="mt-4 text-center text-teal-700 text-sm">Having trouble seeing the calendar? <a href="https://links.debugginghumancommunication.com/widget/booking/AtiyMWERWdg3TT1IQwVh" target="_blank" rel="noopener noreferrer" class="underline hover:text-teal-900">Book directly here</a>.</p>
      </div>
    </section>
  </main>

  <SiteFooter
    copyright={footer.copyright || ''}
    termsUrl={footer.termsUrl || ''}
    privacyUrl={footer.privacyUrl || ''}
  />
</Layout>

<style>
  .prose-custom p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--color-teal-900);
    margin-bottom: 1.25rem;
  }

  .prose-custom strong {
    color: var(--color-teal-950);
  }
</style>
