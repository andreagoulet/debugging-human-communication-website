---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EmailSignupForm from '../components/EmailSignupForm.astro';
import FeaturedTestimonial from '../components/FeaturedTestimonial.astro';
import { getCollection } from 'astro:content';
import { formatMarkdown } from '../utils/formatMarkdown';

const footer = (await getCollection('website')).find(e => e.id === 'shared/footer.md')!.data;

const allLandingPages = await getCollection('landing-pages');
const content = allLandingPages.find(e => e.id === 'communication-lab.md')!.data;

// Curated testimonials for the Lab — experiment + community stories, in display order.
const featuredTestimonialIds = [
  'testimonials/poornima-vijayashanker.md',
  'testimonials/lada-kesseler.md',
  'testimonials/ted-young.md',
  'testimonials/soumya-kulkarni.md',
  'testimonials/ellis-lempriere.md',
];
const allShared = await getCollection('shared');
const testimonials = featuredTestimonialIds
  .map(id => allShared.find(e => e.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

// Video testimonial featured above the grid.
const videoTestimonial = allShared.find(e => e.id === 'testimonials/ray-myers.md');

import { FIT_CALL_URL } from '../utils/constants';

const BOOKING_URL = FIT_CALL_URL;
---

<Layout
  title={content.title}
  description={content.description}
  ogImage="/og-coaching.png"
>
  <SiteHeader currentPath="/" />

  <main>
    <!-- Hero -->
    <section class="bg-white">
      <div class="max-w-4xl mx-auto px-6 pt-12 pb-16 lg:pt-16 text-center">
        <h1 class="hero-headline mb-5" set:html={formatMarkdown(content.hero.headline)} />

        <p class="text-lg md:text-xl text-teal-900 leading-relaxed max-w-3xl mx-auto mb-8" set:html={formatMarkdown(content.hero.subheadline)} />

        <video
          class="hero-video w-full max-w-3xl mx-auto rounded-xl shadow-md bg-teal-950"
          controls
          preload="metadata"
          poster="/videos/dhc-program-poster.jpg"
          aria-label="Andrea Goulet introduces the Debugging Human Communication program"
        >
          <source src="/videos/dhc-program.mp4" type="video/mp4" />
          <track src="/videos/dhc-program.vtt" kind="subtitles" srclang="en" label="English" default />
          Your browser does not support the video tag.
        </video>
        <p class="mt-3 text-center text-sm text-teal-700">
          Video not playing? <a href="https://share.descript.com/view/c0WKXspZ0JN" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-coral">Watch it online</a>
        </p>

        <div class="mt-8">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Book a Free Fit Call
          </a>
          <p class="mt-4 text-teal-900">
            Not ready to talk?
            <a href="#email-signup" class="underline underline-offset-2 text-teal-950 hover:text-coral">Get communication experiments by email</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Meet Andrea (bio) -->
    <section class="section bg-teal-50">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-coral mb-3">{content.bio.eyebrow}</p>
            <h2 class="heading-section mb-5">{content.bio.title}</h2>
            <div class="prose-custom">
              {content.bio.paragraphs.map((p: string) => (
                <p set:html={formatMarkdown(p)} />
              ))}
            </div>
          </div>
          <img
            src={content.bio.image}
            alt={content.bio.imageAlt}
            width="1500"
            height="2249"
            loading="lazy"
            class="w-56 mx-auto md:mx-0 rounded-2xl shadow-md"
          />
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="section bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="heading-section mb-10 text-center">{content.testimonials.title}</h2>

        {videoTestimonial && (
          <div class="mb-8">
            <FeaturedTestimonial
              quote={videoTestimonial.data.quote}
              author={videoTestimonial.data.author}
              role={videoTestimonial.data.role}
              headshot={videoTestimonial.data.headshot}
              video={videoTestimonial.data.video}
              videoPoster={videoTestimonial.data.videoPoster}
            />
          </div>
        )}

        <div class="grid md:grid-cols-2 gap-8">
          {testimonials.map((t) => (
            <blockquote class="bg-teal-50 rounded-xl p-8 border border-teal-200">
              <svg class="w-8 h-8 text-teal-300 mb-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="text-lg text-teal-900 italic mb-4" set:html={`&ldquo;${formatMarkdown(t.data.quote)}&rdquo;`} />
              <footer class="flex items-center gap-3">
                {t.data.headshot ? (
                  <img src={t.data.headshot} alt={t.data.author} class="w-10 h-10 rounded-full object-cover shrink-0" />
                ) : (
                  <div class="w-10 h-10 rounded-full bg-teal-950 flex items-center justify-center text-white font-bold text-xs shrink-0" aria-hidden="true">{t.data.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}</div>
                )}
                <div>
                  <p class="text-teal-950 font-semibold">{t.data.author}</p>
                  {t.data.role && <p class="text-teal-700 text-sm">{t.data.role}</p>}
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- Who this is for: roles you'll identify with -->
    <section class="section bg-teal-950">
      <div class="max-w-7xl mx-auto">
        <h2 class="heading-section !text-white mb-4 text-center">{content.audience.title}</h2>
        <p class="text-lg text-teal-200 max-w-2xl mx-auto mb-10 text-center">{content.audience.intro}</p>
        <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-px bg-teal-200 rounded-xl overflow-hidden border border-teal-200 shadow-sm max-w-5xl mx-auto list-none">
          {content.audience.domains.map((domain: string) => (
            <li class="bg-white px-4 py-4 text-center text-teal-950 font-medium">{domain}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- What starts to change -->
    <section class="section bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="heading-section mb-4 text-center">{content.imagine.title}</h2>
        <p class="text-lg text-teal-900 max-w-2xl mx-auto mb-10 text-center">{content.imagine.subtitle}</p>

        <div class="max-w-3xl mx-auto mb-10 bg-teal-50 rounded-2xl overflow-hidden shadow-sm border border-teal-200">
          {content.imagine.items.map((item: { before: string; after: string }, index: number) => (
            <div class:list={["grid grid-cols-[1fr_auto_1fr] items-center gap-x-4 px-6 py-5", index < content.imagine.items.length - 1 && "border-b border-teal-200"]}>
              <p class="text-teal-900 text-lg">{item.before}</p>
              <svg class="w-6 h-6 text-coral shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" role="img" aria-label="becomes"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              <p class="text-teal-950 font-bold text-lg">{item.after}</p>
            </div>
          ))}
        </div>

        <p class="text-lg text-teal-900 font-medium max-w-2xl mx-auto text-center">{content.imagine.closing}</p>
      </div>
    </section>

    <!-- Program bridge: full details live on /pricing -->
    <section class="section bg-teal-950">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="heading-section !text-white mb-4">{content.programBridge.title}</h2>
        <p class="text-lg text-teal-200 mb-8">{content.programBridge.description}</p>
        <a href="/pricing" class="btn-primary">{content.programBridge.ctaText}</a>
      </div>
    </section>

    <!-- What you're working on: common challenges -->
    <section class="section bg-teal-50">
      <div class="max-w-7xl mx-auto">
        <h2 class="heading-section mb-4 text-center">{content.challenges.title}</h2>
        <p class="text-lg text-teal-900 max-w-2xl mx-auto mb-10 text-center">{content.challenges.intro}</p>
        <ul class="grid md:grid-cols-2 gap-4 max-w-4xl mx-auto list-none">
          {content.challenges.items.map((item: string) => (
            <li class="flex gap-3 items-start bg-white rounded-xl p-5 border border-teal-200">
              <svg class="w-5 h-5 text-coral shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-teal-900">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Closing call-to-action -->
    <section id="schedule" class="section bg-white scroll-mt-4">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="heading-section mb-4">{content.cta.title}</h2>

        <div class="prose-custom mb-8">
          {content.cta.paragraphs.map((p: string) => (
            <p set:html={formatMarkdown(p)} />
          ))}
        </div>

        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Book a Free Fit Call
        </a>
      </div>
    </section>

    <!-- Email signup: the "not ready to talk yet" offramp -->
    <section id="email-signup" class="section bg-teal-950 scroll-mt-4">
      <div class="max-w-lg mx-auto">
        <EmailSignupForm heading={content.hero.emailHeading} text={content.hero.emailText} formId="closing-lead" />
      </div>
    </section>
  </main>

  <SiteFooter
    copyright={footer.copyright || ''}
    termsUrl={footer.termsUrl || ''}
    privacyUrl={footer.privacyUrl || ''}
  />
</Layout>

<style>
  /* Hero headline: a touch smaller than .heading-hero so the longer copy
     wraps to balanced lines and aligns with the top of the portrait. */
  .hero-headline {
    font-size: clamp(2rem, 1.1rem + 2.6vw, 2.875rem);
    line-height: 1.1;
    text-wrap: balance;
    font-weight: 800;
    color: var(--color-teal-950);
  }

  .prose-custom p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--color-teal-900);
    margin-bottom: 1.25rem;
  }

  .prose-custom strong {
    color: var(--color-teal-950);
  }

  /* The element is a bit taller than the 16:9 picture, which is pinned to the
     top — captions render inside the element, so they land in the dark band
     below the picture instead of over the speaker's face. */
  .hero-video {
    aspect-ratio: 16 / 10.4;
    object-fit: contain;
    object-position: top center;
  }
</style>
