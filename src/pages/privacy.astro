---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { formatMarkdown } from '../utils/formatMarkdown';

const shared = await getCollection('website');
const footer = shared.find(e => e.id === 'shared/footer.md')!.data;
const content = shared.find(e => e.id === 'shared/privacy.md')!.data;
---

<Layout
  title={content.title}
  description={content.description}
>
  <SiteHeader currentPath="/privacy" />
  <main>
    <section class="section bg-teal-950">
      <div class="container-md text-center">
        <h1 class="heading-hero mb-6 !text-white">{content.hero.headline}</h1>
        <p class="text-lg text-teal-200">Effective as of {content.hero.effectiveDate}</p>
        <p class="text-teal-300">Company: {content.hero.company}</p>
        <p class="text-teal-300">
          Contact: <a href={`mailto:${content.hero.contactEmail}`} class="text-white underline hover:text-teal-200 focus:outline-2 focus:outline-offset-2 focus:outline-white">{content.hero.contactEmail}</a>
        </p>
      </div>
    </section>

    <section class="section bg-white">
      <div class="container-sm">
        <div class="prose-legal">
          {content.sections.map((section: any) => (
            <div>
              <h2>{section.heading}</h2>

              {section.content?.map((paragraph: string) => (
                <p set:html={formatMarkdown(paragraph)} />
              ))}

              {section.list && (
                <ul>
                  {section.list.map((item: string) => (
                    <li set:html={formatMarkdown(item)} />
                  ))}
                </ul>
              )}

              {section.afterList?.map((paragraph: string) => (
                <p set:html={formatMarkdown(paragraph)} />
              ))}

              {section.secondList && (
                <ul>
                  {section.secondList.map((item: string) => (
                    <li set:html={formatMarkdown(item)} />
                  ))}
                </ul>
              )}

              {section.address && (
                <p class="address">
                  {section.address.name}<br />
                  {section.address.street}<br />
                  {section.address.cityStateZip}<br />
                  {section.address.phone && <><a href={`tel:${section.address.phone.replace(/\./g, '')}`} class="legal-link">{section.address.phone}</a><br /></>}
                  <a href={`mailto:${section.address.email}`} class="legal-link">{section.address.email}</a>
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter
    copyright={footer.copyright || ''}
    termsUrl="/terms"
    privacyUrl="/privacy"
  />
</Layout>

<style>
  .prose-legal h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-teal-950);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose-legal p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-teal-900);
    margin-bottom: 1rem;
  }

  .prose-legal :global(strong) {
    color: var(--color-teal-950);
  }

  .prose-legal ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    color: var(--color-teal-900);
    margin-bottom: 1rem;
  }

  .prose-legal ul li {
    margin-bottom: 0.5rem;
  }

  .prose-legal :global(a),
  .prose-legal .legal-link {
    color: var(--color-teal-950);
    text-decoration: underline;
  }

  .prose-legal :global(a:hover),
  .prose-legal .legal-link:hover {
    color: var(--color-teal-900);
  }

  .prose-legal :global(a:focus),
  .prose-legal .legal-link:focus {
    outline: 2px solid var(--color-teal-950);
    outline-offset: 2px;
  }

  .prose-legal .address {
    line-height: 1.8;
  }
</style>
