---
interface Props {
  id: string;
  title: string;
  timing: string;
  open?: boolean;
}

const { id, title, timing, open = false } = Astro.props;
---

<details id={id} class="agenda-section group bg-white rounded-xl border border-teal-200 shadow-sm mb-4 overflow-hidden" open={open}>
  <summary class="flex items-start justify-between gap-4 cursor-pointer px-6 py-5 list-none hover:bg-teal-50 transition-colors">
    <div class="flex-1 min-w-0">
      <h2 class="text-xl md:text-2xl font-bold text-teal-950 mb-1">{title}</h2>
      <p class="text-sm text-teal-800 font-medium">{timing}</p>
    </div>
    <svg class="w-6 h-6 text-teal-800 shrink-0 mt-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>
  <div class="px-6 pb-6 pt-2 border-t border-teal-100 agenda-body">
    <slot />
  </div>
</details>

<style>
  .agenda-section summary::-webkit-details-marker {
    display: none;
  }
  .agenda-body :global(p) {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-teal-900);
    line-height: 1.6;
  }
  .agenda-body :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-teal-950);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .agenda-body :global(h4) {
    margin-top: 1.25rem;
    margin-bottom: 0.25rem;
    color: var(--color-teal-950);
    font-size: 1rem;
    font-weight: 700;
  }
  .agenda-body :global(blockquote) {
    border-left: 4px solid var(--color-teal-600);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    background: var(--color-teal-50);
    color: var(--color-teal-900);
    font-style: italic;
  }
  .agenda-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }
  .agenda-body :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }
  .agenda-body :global(li) {
    margin: 0.25rem 0;
    color: var(--color-teal-900);
    line-height: 1.6;
  }
  .agenda-body :global(strong) {
    color: var(--color-teal-950);
    font-weight: 700;
  }
  .agenda-body :global(.callout-note) {
    background: var(--color-teal-50);
    border: 1px solid var(--color-teal-200);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    font-size: 0.875rem;
  }
  .agenda-body :global(.stage-direction) {
    font-style: italic;
    color: var(--color-teal-700);
    font-size: 0.95rem;
  }
</style>
