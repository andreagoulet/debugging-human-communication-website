---
import { CALENDLY_URL } from '../utils/constants';
import { formatMarkdown } from '../utils/formatMarkdown';

interface Props {
  title: string;
  intro?: string;
  paragraphs?: Array<string | { text: string; emphasis?: 'bold' | 'italic' }>;
  closing?: string;
  ctaText?: string;
  ctaSubtext?: string;
}

const { title, intro, paragraphs, closing, ctaText = 'Book Your Discovery Session →', ctaSubtext } = Astro.props;
---

<section class="section bg-teal-950 text-white">
  <div class="container-sm">
    <h2 class="heading-section !text-white mb-10 text-center" set:html={formatMarkdown(title)} />

    <div class="bg-white rounded-xl p-8 md:p-10 shadow-lg">
      {intro && (
        <p class="text-xl text-teal-900 mb-6" set:html={formatMarkdown(intro)} />
      )}

      {paragraphs?.map((p) => {
        const para = typeof p === 'string' ? { text: p } : p;
        return para.emphasis === 'bold' ? (
          <p class="text-2xl text-teal-950 font-bold mb-6" set:html={formatMarkdown(para.text)} />
        ) : (
          <p class="text-lg text-teal-900 mb-6" set:html={formatMarkdown(para.text)} />
        );
      })}

      {closing && (
        <p class="text-xl text-teal-950 font-medium mb-8" set:html={formatMarkdown(closing)} />
      )}

      <div class="text-center">
        <a href={CALENDLY_URL} class="btn-primary-lg">
          {ctaText}
        </a>
      </div>
    </div>

    {ctaSubtext && (
      <p class="text-teal-200 text-sm text-center mt-6" set:html={formatMarkdown(ctaSubtext)} />
    )}
  </div>
</section>
