---
/**
 * Brand-styled email capture form.
 * Client verifies with reCAPTCHA v3, then POSTs to /api/lead, which verifies
 * the token server-side and creates a Person + Lead in Pipedrive.
 *
 * Env: PUBLIC_RECAPTCHA_SITE_KEY (client), plus RECAPTCHA_SECRET_KEY and
 * PIPEDRIVE_API_TOKEN on the server (used by /api/lead).
 */
interface Props {
  heading: string;
  text: string;
}
const { heading, text } = Astro.props;
const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<div class="rounded-xl border border-teal-200 shadow-sm bg-teal-50 p-4 md:p-5">
  <h2 class="text-lg font-bold text-teal-950 mb-1">{heading}</h2>
  <p class="text-teal-900 text-sm mb-4">{text}</p>

  <form id="lead-form" class="space-y-3" novalidate>
    <input
      type="text"
      name="name"
      placeholder="Name"
      autocomplete="name"
      class="w-full px-4 py-3 rounded-lg bg-white text-teal-950 placeholder:text-teal-950/60 border border-teal-200 focus:outline-2 focus:outline-teal-800"
    />
    <input
      type="email"
      name="email"
      required
      placeholder="Email"
      autocomplete="email"
      class="w-full px-4 py-3 rounded-lg bg-white text-teal-950 placeholder:text-teal-950/60 border border-teal-200 focus:outline-2 focus:outline-teal-800"
    />

    <!-- Honeypot: hidden from people; bots tend to fill it. -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <button type="submit" class="btn-primary w-full text-center">Send it to me</button>

    <p class="text-teal-900 text-xs leading-relaxed">
      By submitting, you agree to receive emails from Andrea Goulet. Unsubscribe anytime.
      See our <a href="/privacy" class="underline hover:text-teal-950">Privacy Policy</a>.
      This site is protected by reCAPTCHA.
    </p>
    <p id="lead-status" class="text-sm min-h-[1.25em]" aria-live="polite"></p>
  </form>
</div>

<script is:inline src={`https://www.google.com/recaptcha/api.js?render=${siteKey}`}></script>
<script define:vars={{ siteKey }}>
  const form = document.getElementById('lead-form');
  const status = document.getElementById('lead-status');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button');
    const data = new FormData(form);
    const email = String(data.get('email') || '').trim();

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      status.textContent = 'Please enter a valid email address.';
      status.className = 'text-sm min-h-[1.25em] text-coral';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'text-sm min-h-[1.25em]';

    try {
      const token = await new Promise((resolve, reject) => {
        if (!window.grecaptcha) return reject(new Error('Verification unavailable. Please refresh and try again.'));
        window.grecaptcha.ready(() => {
          window.grecaptcha.execute(siteKey, { action: 'lead' }).then(resolve).catch(reject);
        });
      });

      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email,
          company: data.get('company'),
          token,
        }),
      });

      if (res.ok) {
        status.textContent = 'You’re in — check your inbox soon.';
        status.classList.add('text-teal-950');
        form.reset();
        btn.textContent = 'Done!';
      } else {
        const text = await res.text();
        let message = 'Something went wrong. Please try again.';
        try { message = JSON.parse(text).error || message; } catch {}
        throw new Error(message);
      }
    } catch (err) {
      status.textContent = err.message || 'Something went wrong. Please try again.';
      status.classList.add('text-coral');
      btn.disabled = false;
      btn.textContent = 'Send it to me';
    }
  });
</script>
